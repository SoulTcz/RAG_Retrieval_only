# Copy this file to .env and fill in real values. Never commit the real .env.

# --- MongoDB ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=PPT_Reterival

# --- JWT auth ---
SECRET_KEY=change-this-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=180
ADMIN_CREATION_SECRET=super-secret-admin-key

# --- Product image uploads (existing e-commerce feature) ---
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE=5242880

# --- PPT/PDF retrieval feature ---
PDF_UPLOAD_FOLDER=uploads/ppt
# Images extracted from PDFs are stored in MongoDB GridFS (bucket "ppt_images"),
# not on disk — so no PDF_IMAGE_FOLDER setting is needed.
MAX_PDF_SIZE=26214400
PDF_CHUNK_SIZE=800
PDF_CHUNK_OVERLAP=100
FALLBACK_CHUNK_SIZE=400
FALLBACK_CHUNK_OVERLAP=80
PPT_CHUNKS_COLLECTION=ppt_chunks
SIMILARITY_THRESHOLD=0.55

# --- Gemini (image description) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY=5.0
